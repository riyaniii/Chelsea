using Gtk 4.0;
using Adw 1;

template $ChelseaDiscoverPage : Adw.Bin {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [start]
      $ChelseaSidebarButton {}

      title-widget: Gtk.Box {
        spacing: 6;

        Gtk.DropDown type_dropdown {
          tooltip-text: _("Type");
          notify::selected => $on_type_changed();
          styles ["flat"]
        }

        Gtk.DropDown catalog_dropdown {
          tooltip-text: _("Catalog");
          notify::selected => $on_catalog_changed();
          styles ["flat"]
        }

        Gtk.DropDown genre_dropdown {
          tooltip-text: _("Genre");
          enable-search: true;
          notify::selected => $on_genre_changed();
          styles ["flat"]
        }
      };
    }

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "loading";

        child: Adw.Spinner {
          width-request: 48;
          height-request: 48;
          halign: center;
          valign: center;
        };
      }

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "compass-symbolic";
          title: _("Nothing Here");
          description: _("This catalog has no titles");
        };
      }

      Gtk.StackPage {
        name: "grid";
        child: $ChelseaGrid grid {
          load-more => $on_load_more();
        };
      }
    };
  };
}
