using Gtk 4.0;
using Adw 1;

template $ChelseaDownloadsPage : Adw.Bin {
  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: $ChelseaPathBar path_bar {
        folder-selected => $on_folder_selected();
      };

      [start]
      $ChelseaSidebarButton {}

      [start]
      $ChelseaHistoryControls history {
        location-chosen => $on_location_chosen();
      }
    }

    content: Gtk.Stack stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "empty";

        child: Adw.StatusPage empty_page {
          icon-name: "folder-download-symbolic";
        };
      }

      Gtk.StackPage {
        name: "files";

        child: $ChelseaFileGrid file_grid {
          activated => $on_file_activated();
          menu-opening => $on_menu_opening();
        };
      }
    };
  };
}
