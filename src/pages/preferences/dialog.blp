using Gtk 4.0;
using Adw 1;

template $ChelseaPreferencesDialog : Adw.PreferencesDialog {
  content-width: 720;
  content-height: 480;
  search-enabled: true;

  Adw.PreferencesPage {
    name: "playback";
    title: _("Playback");
    icon-name: "media-playback-start-symbolic";

    Adw.PreferencesGroup {
      title: _("Video");

      Adw.SwitchRow hwdec_row {
        title: _("Hardware Decoding");
        subtitle: _("Use the GPU to decode video when possible");
      }

      Adw.SwitchRow discrete_gpu_row {
        title: _("Use Discrete GPU");
        subtitle: _("Play video on the NVIDIA graphics card, which uses more battery. Applies after restarting Chelsea");
      }
    }

    Adw.PreferencesGroup {
      title: _("Languages");
      description: _("When a video has several audio or subtitle tracks, Chelsea picks the ones in these languages");

      Adw.ComboRow audio_language_row {
        title: _("Audio Language");
      }

      Adw.ComboRow subtitle_language_row {
        title: _("Subtitle Language");
      }

      Adw.SwitchRow hide_subtitles_row {
        title: _("Hide Other Subtitle Languages");
        subtitle: _("Only list subtitles in the chosen subtitle language");
      }
    }

    Adw.PreferencesGroup {
      title: _("Streams");

      Adw.SwitchRow group_streams_row {
        title: _("Group Streams by Addon");
        subtitle: _("Show a tab for each addon instead of one list with every stream");
      }
    }
  }

  Adw.PreferencesPage {
    name: "torrents";
    title: _("Torrents");
    icon-name: "chain-link-symbolic";

    Adw.PreferencesGroup {
      title: _("Engine");
      description: _("Changes apply the next time the torrent engine starts");

      Adw.ComboRow profile_row {
        title: _("Connection Profile");
        subtitle: _("How aggressively to connect to peers");

        model: Gtk.StringList {
          strings [
            _("Gentle"),
            _("Balanced"),
            _("Fast")
          ]
        };
      }

      Adw.SwitchRow upload_row {
        title: _("Share While Watching");
        subtitle: _("Upload to other peers during playback");
      }
    }

    Adw.PreferencesGroup {
      title: _("Storage");

      Adw.SpinRow cache_row {
        title: _("Disk Cache Size");
        subtitle: _("In gigabytes");

        adjustment: Gtk.Adjustment {
          lower: 1;
          upper: 200;
          step-increment: 1;
          page-increment: 10;
        };
      }

      Adw.ActionRow {
        title: _("Clear Torrent Cache");
        subtitle: _("Free the disk space used by watched torrents");
        activatable: true;
        activated => $on_clear_cache_activated();

        [suffix]
        Gtk.Image {
          icon-name: "user-trash-symbolic";
        }
      }
    }
  }

  Adw.PreferencesPage {
    name: "downloads";
    title: _("Downloads");
    icon-name: "folder-download-symbolic";

    Adw.PreferencesGroup {
      title: _("Downloads");
      description: _("Each movie or series gets its own folder inside the download location");

      Adw.ActionRow download_folder_row {
        styles ["property"]
        title: _("Download Location");
        activatable: true;
        activated => $on_download_folder_activated();

        [suffix]
        Gtk.Image {
          icon-name: "folder-open-symbolic";
        }
      }

      Adw.SwitchRow ask_location_row {
        title: _("Ask Every Time");
        subtitle: _("Choose where to save each download");
      }
    }
  }

  Adw.PreferencesPage {
    name: "account";
    title: _("Account");
    icon-name: "avatar-default-symbolic";

    Adw.PreferencesGroup {
      Adw.Avatar account_avatar {
        size: 128;
        show-initials: true;
        halign: center;
      }
    }

    Adw.PreferencesGroup {
      Adw.EntryRow name_row {
        title: _("Name");
        show-apply-button: true;
        apply => $on_name_applied();
      }

      Adw.ActionRow email_row {
        styles [
          "property"
        ]

        title: _("Email");
        subtitle-selectable: true;
      }
    }

    Adw.PreferencesGroup {
      Adw.SwitchRow open_last_profile_row {
        title: _("Skip Profile Selection");
        subtitle: _("Open the last used profile when Chelsea starts");
      }
    }

    Adw.PreferencesGroup {
      Adw.ButtonRow sign_in_row {
        styles [
          "suggested-action"
        ]

        title: _("Add a Stremio Account");
        activated => $on_sign_in_activated();
      }

      Adw.ButtonRow sign_out_row {
        styles [
          "destructive-action"
        ]

        title: _("Sign Out");
        activated => $on_sign_out_activated();
      }
    }
  }
}
