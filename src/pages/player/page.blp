using Gtk 4.0;
using Adw 1;
template $ChelseaPlayerPage : Adw.NavigationPage {
  styles [
    "player"
  ]

  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 294;

    Adw.Breakpoint {
      condition ("max-width: 566sp")

      setters {
        controls_separator.visible: false;
      }
    }

    child: Gtk.WindowHandle window_handle {
      child: Gtk.Overlay video_overlay {
        styles [
          "video-overlay"
        ]

        child: Adw.Bin video_bin {};

        [overlay]
        Gtk.Revealer revealer_icon_indicator {
          transition-duration: 385;
          transition-type: crossfade;
          can-target: false;

          child: Gtk.Image icon_indicator {
            styles [
              "icon-indicator"
            ]

            halign: center;
            valign: center;
            pixel-size: 64;
          };
        }

        [overlay]
        Gtk.Stack status_stack {
          transition-type: crossfade;
          halign: center;
          valign: center;
          visible: false;
          can-target: false;

          Gtk.StackPage {
            name: "loading";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;

              Adw.Spinner {
                styles [
                  "cine-spinner"
                ]

                width-request: 90;
                height-request: 90;
                halign: center;
              }

              Gtk.Label status_label {
                styles [
                  "status-text",
                  "heading"
                ]
              }

              Gtk.Label status_detail {
                styles [
                  "status-text",
                  "caption",
                  "numeric"
                ]
              }
            };
          }

          Gtk.StackPage {
            name: "error";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 6;

              Gtk.Image {
                styles [
                  "status-text"
                ]

                icon-name: "cine-warning-symbolic";
                pixel-size: 64;
                margin-bottom: 6;
              }

              Gtk.Label error_label {
                styles [
                  "status-text",
                  "title-4"
                ]

                wrap: true;
                justify: center;
                max-width-chars: 32;
              }

              Gtk.Label error_detail {
                styles [
                  "status-text"
                ]

                wrap: true;
                justify: center;
                max-width-chars: 40;
              }
            };
          }
        }

        [overlay]
        Gtk.Revealer revealer_ui {
          transition-duration: 300;
          transition-type: crossfade;
          reveal-child: true;

          child: Gtk.Box {
            styles [
              "header-and-controls"
            ]

            orientation: vertical;

            Adw.HeaderBar headerbar {
              styles [
                "osd",
                "header-bar"
              ]

              valign: start;

              title-widget: Adw.WindowTitle title_widget {};
            }

            Gtk.Separator {
              vexpand: true;
              opacity: 0;
            }

            Gtk.Box controls_box {
              styles [
                "osd",
                "controls"
              ]

              valign: end;
              orientation: vertical;

              Adw.WrapBox {
                align: 0.5;
                valign: center;
                margin-start: 13;
                margin-end: 13;
                child-spacing: 4;
                wrap-reverse: true;
                justify: spread;
                justify-last-line: true;
                line-spacing: 5;

                Gtk.Button previous_btn {
                  styles [
                    "circular",
                    "flat"
                  ]

                  icon-name: "cine-skip-backward-symbolic";
                  tooltip-text: _("Previous Episode");
                  clicked => $on_previous_clicked();
                }

                Gtk.Button play_pause_btn {
                  styles [
                    "circular",
                    "flat"
                  ]

                  icon-name: "cine-playback-pause-symbolic";
                  tooltip-text: _("Play/Pause");
                  halign: center;
                  clicked => $on_play_clicked();
                }

                Gtk.Button next_btn {
                  styles [
                    "circular",
                    "flat"
                  ]

                  icon-name: "cine-skip-forward-symbolic";
                  tooltip-text: _("Next Episode");
                  halign: center;
                  clicked => $on_next_clicked();
                }

                Gtk.MenuButton volume_menu_btn {
                  styles [
                    "flat",
                    "circular"
                  ]

                  halign: center;
                  icon-name: "cine-volume-max-symbolic";
                  tooltip-text: _("Volume");
                  direction: up;

                  popover: Gtk.Popover {
                    child: Gtk.Box {
                      Gtk.ToggleButton mute_toggle_btn {
                        styles [
                          "flat",
                          "circular",
                          "toggle-mute"
                        ]

                        icon-name: "cine-volume-mute-symbolic";
                        tooltip-text: _("Mute");
                        toggled => $on_mute_toggled();
                      }

                      Gtk.Scale volume_scale {
                        styles [
                          "volume-scale"
                        ]

                        width-request: 180;
                        value-changed => $on_volume_changed();

                        adjustment: Gtk.Adjustment volume_scale_adj {
                          lower: 0;
                          upper: 130;
                          value: 100;
                          step-increment: 5;
                          page-increment: 10;
                        };
                      }
                    };
                  };
                }

                Gtk.MenuButton subtitles_menu_btn {
                  styles [
                    "circular",
                    "flat",
                    "first-label-bold"
                  ]

                  direction: up;
                  halign: center;
                  icon-name: "cine-subtitles-symbolic";
                  tooltip-text: _("Subtitles");
                }

                Gtk.MenuButton audio_tracks_menu_btn {
                  styles [
                    "circular",
                    "flat",
                    "first-label-bold"
                  ]

                  direction: up;
                  halign: center;
                  icon-name: "cine-audio-symbolic";
                  tooltip-text: _("Audio Tracks");
                }

                Gtk.MenuButton video_tracks_menu_btn {
                  styles [
                    "circular",
                    "flat"
                  ]

                  direction: up;
                  halign: center;
                  icon-name: "cine-video-symbolic";
                  tooltip-text: _("Video Tracks");
                }

                Gtk.MenuButton chapters_menu_btn {
                  styles [
                    "circular",
                    "flat"
                  ]

                  direction: up;
                  halign: center;
                  icon-name: "cine-chapters-symbolic";
                  tooltip-text: _("Chapters");
                  notify::active => $on_chapters_menu_active();
                }

                Gtk.Separator controls_separator {
                  hexpand: true;
                  opacity: 0;
                }

                $ChelseaOptionsButton options_menu_btn {
                  valign: end;
                }

                Gtk.Button fullscreen_btn {
                  styles [
                    "circular",
                    "flat"
                  ]

                  icon-name: "cine-view-fullscreen-symbolic";
                  tooltip-text: _("Fullscreen");
                  valign: end;
                  halign: center;
                  clicked => $on_fullscreen_clicked();
                }
              }

              Gtk.Box {
                valign: center;
                margin-start: 3;
                margin-end: 20;
                margin-bottom: 5;
                height-request: 37;

                Gtk.Scale video_progress_scale {
                  halign: fill;
                  hexpand: true;
                  valign: center;
                  margin-start: 8;
                  margin-end: 3;

                  adjustment: Gtk.Adjustment video_progress_adj {
                    lower: 0;
                    upper: 100;
                    value: 0;
                    step-increment: 5;
                    page-increment: 30;
                  };
                }

                Gtk.Button time_elapsed_button {
                  styles [
                    "heading",
                    "numeric",
                    "flat",
                    "circular",
                    "time-elapsed"
                  ]

                  halign: end;
                  valign: center;
                  tooltip-text: _("Toggle Remaining Time");
                  clicked => $on_toggle_elapsed_remaining();

                  child: Gtk.Label time_elapsed_label {
                    label: "0:00";
                    width-chars: 5;
                  };
                }

                Gtk.Separator {
                  styles [
                    "time-separator"
                  ]

                  height-request: 16;
                  width-request: 2;
                  valign: center;
                  margin-start: 10;
                  margin-end: 10;
                }

                Gtk.Label time_total_label {
                  styles [
                    "heading",
                    "numeric"
                  ]

                  halign: end;
                  label: "0:00";
                }
              }
            }
          };
        }
      };
    };
  };
}
