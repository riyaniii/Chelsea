using Gtk 4.0;
using Adw 1;

template $ChelseaMainView : Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      split_view.collapsed: true;
    }
  }

  child: Adw.ToastOverlay toast_overlay {
    child: Adw.NavigationView main_nav_view {
      Adw.NavigationPage {
        title: _("Chelsea");
        tag: "main";

        child: Adw.OverlaySplitView split_view {
          min-sidebar-width: 240;
          max-sidebar-width: 260;

          sidebar: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              title-widget: Adw.WindowTitle {
                title: _("Chelsea");
              };

              [end]
              Gtk.MenuButton {
                primary: true;
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;
              }
            }

            content: Adw.ViewSwitcherSidebar {
              stack: main_stack;
            };
          };

          content: Adw.ViewStack main_stack {
            Adw.ViewStackPage {
              name: "home";
              title: _("Home");
              icon-name: "go-home-symbolic";
              child: $ChelseaHomePage home_page {};
            }

            Adw.ViewStackPage {
              name: "search";
              title: _("Search");
              icon-name: "system-search-symbolic";
              child: $ChelseaSearchPage search_page {};
            }

            Adw.ViewStackPage {
              name: "library";
              title: _("Library");
              icon-name: "library-symbolic";
              child: $ChelseaLibraryPage library_page {};
            }

            Adw.ViewStackPage {
              name: "discover";
              title: _("Discover");
              icon-name: "compass-symbolic";
              child: $ChelseaDiscoverPage discover_page {};
            }

            Adw.ViewStackPage {
              name: "downloads";
              title: _("Downloads");
              icon-name: "folder-download-symbolic";
              child: $ChelseaDownloadsPage downloads_page {};
            }

            Adw.ViewStackPage {
              name: "addons";
              title: _("Addons");
              icon-name: "application-x-addon-symbolic";
              child: $ChelseaAddonsPage addons_page {};
            }
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Switch Profile");
      action: "app.switch_profile";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_Support Chelsea");
      action: "app.donate";
    }

    item {
      label: _("_About Chelsea");
      action: "app.about";
    }
  }
}
