using Gtk 4.0;
using Adw 1;

template $ChelseaLinkDialog : Adw.Dialog {
  follows-content-size: true;
  closed => $on_closed();

  child: Adw.ToolbarView {
    width-request: 360;

    [top]
    Adw.HeaderBar {}

    content: Gtk.ScrolledWindow {
      hscrollbar-policy: never;
      propagate-natural-height: true;
      max-content-height: 480;

      child: Gtk.Box {
        orientation: vertical;
        spacing: 24;
        margin-top: 12;
        margin-bottom: 24;
        margin-start: 12;
        margin-end: 12;

        Gtk.Box {
          orientation: vertical;
          spacing: 12;

          Adw.Bin {
            styles [
              "addon-logo"
            ]

            halign: center;
            overflow: hidden;

            child: Gtk.Image image {
              pixel-size: 96;
            };
          }

          Gtk.Label title_label {
            styles [
              "title-2"
            ]

            wrap: true;
            wrap-mode: word_char;
            justify: center;
            max-width-chars: 30;
          }

          Gtk.Label description_label {
            styles [
              "dimmed"
            ]

            wrap: true;
            wrap-mode: word_char;
            justify: center;
            max-width-chars: 30;
            lines: 4;
            ellipsize: end;
          }
        }

        Gtk.Stack stack {
          transition-type: crossfade;
          vhomogeneous: false;
          interpolate-size: true;

          Gtk.StackPage {
            name: "loading";

            child: Adw.Spinner {
              width-request: 32;
              height-request: 32;
              halign: center;
            };
          }

          Gtk.StackPage {
            name: "action";

            child: Gtk.Button action_button {
              styles [
                "pill",
                "suggested-action"
              ]

              halign: center;
              clicked => $on_action_clicked();
            };
          }

          Gtk.StackPage {
            name: "error";

            child: Gtk.Label error_label {
              styles [
                "error"
              ]

              wrap: true;
              wrap-mode: word_char;
              justify: center;
              max-width-chars: 30;
            };
          }
        }
      };
    };
  };
}
