using Gtk 4.0;
using Adw 1;

template $ChelseaGrid : Adw.BreakpointBin {
  hexpand: true;
  vexpand: true;
  width-request: 10;
  height-request: 10;

  child: Gtk.ScrolledWindow scroller {
    hscrollbar-policy: never;
    vscrollbar-policy: automatic;
    edge-reached => $on_edge_reached();

    child: Gtk.GridView grid {
      styles [
        "card-grid"
      ]

      single-click-activate: true;
      hscroll-policy: natural;
      vscroll-policy: natural;
      min-columns: 6;
      activate => $on_activate();
    };
  };

  Adw.Breakpoint {
    condition ("max-width: 1300sp")

    setters {
      grid.min-columns: 5;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 1000sp")

    setters {
      grid.min-columns: 4;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      grid.min-columns: 3;
    }
  }

  Adw.Breakpoint {
    condition ("max-width: 400sp")

    setters {
      grid.min-columns: 2;
    }
  }
}
