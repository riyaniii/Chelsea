#!@PYTHON@

import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
pkgdatadir = '@pkgdatadir@'
localedir = '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('chelsea', localedir)
locale.textdomain('chelsea')
gettext.bindtextdomain('chelsea', localedir)
gettext.textdomain('chelsea')
translation = gettext.translation('chelsea', localedir, fallback=True)
gettext.gettext = translation.gettext

if __name__ == '__main__':
    from gi.repository import Gio
    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'chelsea.gresource'))
    Gio.resources_register(resource)

    from chelsea import main
    sys.exit(main.main(VERSION))
